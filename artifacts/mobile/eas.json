{
  "cli": {
    "version": ">= 13.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "trampaj.hr"
      },
      "cache": {
        "key": "hermesc-rn081-v1",
        "paths": [
          "/tmp/hermesc-cache"
        ]
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "trampaj.hr"
      },
      "cache": {
        "key": "hermesc-rn081-v1",
        "paths": [
          "/tmp/hermesc-cache"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
